# ============================================================
# GMAIL AUTO FARM - Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# ============================================================
# MongoDB Configuration
# ============================================================
# Connection string cho MongoDB
# Format: mongodb://[username:password@]host[:port][/database]
# Ví dụ: mongodb://localhost:27017 hoặc mongodb://user:pass@host:27017/dbname
MONGO_URI=mongodb://localhost:27017

# Tên database trong MongoDB
MONGO_DB_NAME=gmail_farm

# ============================================================
# Telegram Configuration
# ============================================================
# Telegram API ID - Lấy từ https://my.telegram.org/apps
# Đăng nhập bằng số điện thoại Telegram của bạn
# Ví dụ: 22359020
TELEGRAM_API_ID=

# Telegram API Hash - Lấy từ https://my.telegram.org/apps
# Cùng trang với API ID
# Ví dụ: 6dbb9685d5fcb675affaa37ce5018d12
TELEGRAM_API_HASH=

# Tên session file cho Telethon (không cần extension)
# File session sẽ được lưu tại: {session_name}.session
TELEGRAM_SESSION_NAME=gmail_farm_session

# Username của GmailFarmerBot (không có @)
# Ví dụ: nếu bot là @GmailFarmerBot thì điền: GmailFarmerBot
GMAIL_FARMER_BOT_USERNAME=GmailFarmerBot

# ============================================================
# Orchestrator Configuration
# ============================================================
# Số worker tối đa chạy đồng thời (số tài khoản tạo cùng lúc)
# Khuyến nghị: 3-5 tùy theo tài nguyên server
MAX_WORKERS=3

# Khoảng thời gian kiểm tra DB để lấy pending accounts (giây)
# Khuyến nghị: 10-30 giây
SCHEDULER_CHECK_INTERVAL=10

# ============================================================
# GPM API Configuration
# ============================================================
# URL của GPM Profiles API
# - Local GPM: http://127.0.0.1:19995 (không cần API key)
# - Remote GPM: https://api.gpm.com (cần API key)
GPM_API_URL=http://127.0.0.1:19995

# API Key để authenticate với GPM API (chỉ cần khi dùng remote GPM)
# - Local GPM: Để trống hoặc không cần thiết
# - Remote GPM: Lấy từ dashboard của GPM provider
GPM_API_KEY=

# ============================================================
# ZingProxy API Configuration
# ============================================================
# URL của ZingProxy API (không cần thiết, giữ để tương thích)
ZINGPROXY_API_URL=https://api.zingproxy.com

# API Key để authenticate với ZingProxy API (không cần thiết, giữ để tương thích)
# Lấy từ dashboard của ZingProxy provider
ZINGPROXY_API_KEY=

# Link Change IP từ ZingProxy Dashboard
# Lấy từ dashboard ZingProxy: Vào chi tiết proxy → Copy "Link change IP"
# Format: https://api.zingproxy.com/getip/{api_key}
# Ví dụ: https://api.zingproxy.com/getip/18f4288e5f2abdd9dcd475f51af49cc11670533f
ZINGPROXY_CHANGE_IP_LINK=

# Port mặc định của proxy (thường là 8649)
ZINGPROXY_DEFAULT_PORT=8649

# Proxy đã thuê cố định - Lấy từ dashboard ZingProxy
# Vào chi tiết proxy → Copy thông tin từ "HTTP IPv4 Proxy" hoặc từng field riêng:
# - IP:Port: 42.96.10.198:8649 (tách ra thành ZING_PROXY_HOST và ZINGPROXY_DEFAULT_PORT)
# - User: dWd0tm3jkaito
# - Password: gHmWkv1P
# Ví dụ: 42.96.10.198 (lấy từ dashboard ZingProxy)
ZING_PROXY_HOST=
# Ví dụ: dWd0tm3jkaito (lấy từ dashboard ZingProxy)
ZING_PROXY_USER=
# Ví dụ: gHmWkv1P (lấy từ dashboard ZingProxy)
ZING_PROXY_PASS=

# ============================================================
# OTP Service API Configuration
# ============================================================
# URL của OTP Service API (phone rental service)
# Thay đổi theo provider OTP của bạn
OTP_API_URL=https://api.otp.com

# API Key để authenticate với OTP Service API
# Lấy từ dashboard của OTP provider
OTP_API_KEY=64fcd6ff099d4b3793fe244f1144960f

# ============================================================
# Notes:
# ============================================================
# 1. Sau khi copy file này thành .env, hãy điền đầy đủ các giá trị thực tế
# 2. KHÔNG commit file .env vào Git (đã có trong .gitignore)
# 3. File env.example này có thể commit để làm mẫu cho team
# 4. Đảm bảo tất cả API keys có quyền truy cập cần thiết:
#    - GPM API: start/stop profiles, get debugPort
#    - ZingProxy API: get Vietnam proxy
#    - OTP API: rent phone, get OTP codes
# 5. Test từng service riêng trước khi chạy toàn bộ hệ thống

